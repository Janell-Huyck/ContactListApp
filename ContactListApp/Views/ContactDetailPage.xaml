<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactListApp.Views.ContactDetailPage"
             Title="Contact Details"
             xmlns:vm="clr-namespace:ContactListApp.Models.ViewModels"
             x:DataType="vm:ContactDetailViewModel">
    <TableView Intent="Data">
        <TableRoot>
            <TableSection Title="Contact Information">
                <TextCell Text="Name" Detail="{Binding Contact.ContactName}" />
                <TextCell Text="Phone" Detail="{Binding Contact.ContactPhone}" />
                <TextCell Text="Email" Detail="{Binding Contact.Contact.Email}" />
                <TextCell Text="Description" Detail="{Binding Contact.ContactDescription}"/>
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>