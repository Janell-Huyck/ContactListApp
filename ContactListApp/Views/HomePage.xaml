<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactListApp.Views.HomePage"
             Title="Add Contact Page"
             NavigationPage.HasNavigationBar="False"
             xmlns:vm="clr-namespace:ContactListApp.Models.ViewModels"
             x:DataType="vm:ContactListViewModel">
    <VerticalStackLayout Padding="10" Spacing="10">
        <Entry x:Name="contactName" Placeholder="Enter Contact Name" Text="{Binding Contact.ContactName}"/>
        <Entry x:Name="contactPhone" Placeholder="Enter Contact Phone" Text="{Binding Contact.ContactPhone}"/>
        <Entry x:Name="contactEmail" Placeholder="Enter Contact Email" Text="{Binding Contact.Contact.Email}"/>
        <Editor x:Name="contactDescription" Placeholder="Enter Contact Description" Text="{Binding Contact.ContactDescription}" HeightRequest="100"/>
        <Button x:Name="addButton" Text="Save" Command="{Binding AddCommand}"/>
 
    </VerticalStackLayout>
</ContentPage>