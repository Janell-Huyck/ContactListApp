<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ContactListApp.Views.ContactsListPage"
             Title="Contacts Page"
             xmlns:vm="clr-namespace:ContactListApp.Models.ViewModels"
             xmlns:models="clr-namespace:ContactListApp.Models"
             x:DataType="vm:ContactListViewModel">
    <ListView x:Name="Lv" ItemsSource="{Binding Contacts}" SelectionMode="Single" ItemTapped="Lv_ItemTapped">
        <ListView.Header>
            <VerticalStackLayout Padding="10" Spacing="10">
                <Label Text="Contacts" FontSize="Large" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ListView.Header>

        <ListView.ItemTemplate>
            <DataTemplate x:DataType="{x:Type models:Contact}">
                <TextCell Text="{Binding ContactName}" Detail="{Binding ContactEmail}" />
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentPage>